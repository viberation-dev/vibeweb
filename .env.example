# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API). Never commit the filled-in file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# No secret key (sb_secret_...) here on purpose. It bypasses RLS entirely,
# must never be exposed client-side, and no MVP feature needs it.

# Only needed to regenerate types/supabase.ts via `npm run gen:types`.
# Project Settings -> Database -> Connection string (session pooler).
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
