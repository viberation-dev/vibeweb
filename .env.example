# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API). Never commit the filled-in file.

# The Project URL, NOT the dashboard address you copied it from. If this ends
# up as https://supabase.com/dashboard/... every query fails with an HTML
# parse error instead of anything useful, so the app now refuses to start.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase is mid-rename on API keys. Either name works; this one wins if both
# are set. Current projects issue sb_publishable_..., older ones an anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No secret key (sb_secret_...) here on purpose. It bypasses RLS entirely,
# must never be exposed client-side, and no MVP feature needs it.

# No database connection string here either. types/supabase.ts is regenerated
# with the Supabase CLI, which authenticates on its own:
#   supabase gen types typescript --project-id <ref> > types/supabase.ts

# Newsletter (VIB-91). Both must be set for signups to reach Resend; without
# them the form says "not switched on yet" rather than silently accepting an
# address. Create the audience in the Resend dashboard (Audiences → New).
# RESEND_API_KEY=re_...
# RESEND_AUDIENCE_ID=

# Shows the signup form on the live homepage. Unset means: hidden in
# production, visible on Vercel previews for review. Set to "on" when the
# list is ready to send to; "off" hides it everywhere.
# NEWSLETTER_SIGNUP=on
