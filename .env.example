# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings -> API). Never commit the filled-in file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase is mid-rename on API keys. Either name works; this one wins if both
# are set. Current projects issue sb_publishable_..., older ones an anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No secret key (sb_secret_...) here on purpose. It bypasses RLS entirely,
# must never be exposed client-side, and no MVP feature needs it.

# No database connection string here either. types/supabase.ts is regenerated
# with the Supabase CLI, which authenticates on its own:
#   supabase gen types typescript --project-id <ref> > types/supabase.ts
